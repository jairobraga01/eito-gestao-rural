rules_version = '2';

// Os dados de cada conta ficam em usuarios/{dono}/{tabela}/{id}.
// O dono pode pôr outras pessoas na equipe (usuarios/{dono}/equipe/{uid}):
// - gerente: lê e grava tudo, menos a equipe;
// - peão: lê tudo, menos o financeiro; grava só o serviço de campo e só
//   apaga o que ele mesmo lançou;
// - veterinário: como o peão, mas grava a reprodução e a sanidade
//   (inseminação, protocolos, sêmen, diagnóstico, ECC e aplicações);
// - zootecnista: como o peão, mas grava a dieta, as fórmulas, o estoque e as pesagens;
// - contador: lê tudo e grava só o financeiro (contas, custos, dívidas,
//   contatos, cotações e dados fiscais); só apaga o que ele mesmo lançou.
// Convites ficam em convites/{email} e só servem para quem tem esse e-mail
// confirmado (ou para o login de peão que o dono criou, pelo uid).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function meuEmail() {
      return request.auth.token.get('email', '').lower();
    }
    function vinculo(u) {
      return /databases/$(database)/documents/usuarios/$(u)/equipe/$(request.auth.uid);
    }
    function membro(u) {
      return logado() && exists(vinculo(u));
    }
    function papel(u) {
      return get(vinculo(u)).data.papel;
    }
    function conviteServe(c) {
      return c.get('uid', null) == request.auth.uid
        || (c.get('uid', null) == null && request.auth.token.get('email_verified', false) == true);
    }
    function caminhoConvite() {
      return /databases/$(database)/documents/convites/$(meuEmail());
    }
    function conviteDe(u) {
      return meuEmail() != '' && exists(caminhoConvite())
        && get(caminhoConvite()).data.dono == u
        && conviteServe(get(caminhoConvite()).data);
    }
    // Tabelas que cada papel grava. O app espelha estas listas em
    // tabelasPorPapel (lib/dados/db.dart): mudou aqui, muda lá.
    // Tabelas que o peão grava no campo.
    function peaoGrava(t) {
      return t in ['animais', 'pesagens', 'sanidade', 'reproducoes', 'escores', 'ordenhas', 'pastagens',
        'ocorrencias', 'contagens', 'chuvas', 'insumos', 'estoque', 'semens', 'fotos', 'tarefas', 'config',
        'protocolos'];
    }
    // Tabelas que o veterinário grava.
    function vetGrava(t) {
      return t in ['animais', 'reproducoes', 'protocolos', 'estacoes', 'semens', 'sanidade', 'escores', 'pesagens',
        'ocorrencias', 'fotos', 'tarefas', 'config', 'estoque', 'pastagens'];
    }
    // Financeiro: o peão e o veterinário não leem.
    function semFinanceiro(t) {
      return t in ['contas', 'dividas', 'custos'];
    }
    // Quem administra os códigos de indicação (admins/{uid}, criado no console).
    function admin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('ativo', true) != false;
    }
    // Tabelas que o zootecnista grava.
    function zootGrava(t) {
      return t in ['pesagens', 'escores', 'insumos', 'precos_insumo', 'batidas', 'estoque', 'formulas', 'dietas', 'fotos', 'tarefas', 'config',
        'pastagens', 'ocorrencias', 'animais', 'reproducoes', 'sanidade', 'custos'];
    }
    // Tabelas que o contador grava: só o financeiro.
    function contadorGrava(t) {
      return t in ['contas', 'dividas', 'custos', 'contatos', 'cotacoes', 'config'];
    }
    function campoGrava(p, t) {
      return (p == 'peao' && peaoGrava(t)) || (p == 'veterinario' && vetGrava(t))
        || (p == 'zootecnista' && zootGrava(t)) || (p == 'contador' && contadorGrava(t));
    }

    // O dono: tudo dentro da própria conta.
    match /usuarios/{u}/{document=**} {
      allow read, write: if logado() && request.auth.uid == u;
    }
    // O criador vê a fazenda do cliente para dar suporte (só leitura).
    match /usuarios/{u}/{tabela}/{doc} {
      allow read: if admin();
    }

    // Equipe: só o dono muda. A pessoa vê a própria ligação, pode sair e,
    // com um convite válido, entra sozinha com o papel do convite.
    match /usuarios/{u}/equipe/{m} {
      allow read: if logado() && (request.auth.uid == m || membro(u));
      allow delete: if logado() && request.auth.uid == m;
      allow create: if logado() && request.auth.uid == m && conviteDe(u)
        && request.resource.data.papel == get(caminhoConvite()).data.papel;
    }

    // Dados do dono para quem está na equipe.
    match /usuarios/{u}/{tabela}/{doc} {
      allow read: if tabela != 'equipe' && membro(u)
        && !(papel(u) in ['peao', 'veterinario', 'zootecnista'] && semFinanceiro(tabela));
      allow write: if tabela != 'equipe' && membro(u) && papel(u) == 'gerente';
      allow create: if tabela != 'equipe' && membro(u) && campoGrava(papel(u), tabela);
      // Quem lançou não muda: senão bastaria trocar o criado_por para poder apagar.
      allow update: if tabela != 'equipe' && membro(u) && campoGrava(papel(u), tabela)
        && request.resource.data.get('criado_por', '') == resource.data.get('criado_por', '');
      allow delete: if tabela != 'equipe' && membro(u) && campoGrava(papel(u), tabela)
        && resource.data.get('criado_por', '') == request.auth.uid;
    }

    match /convites/{email} {
      allow read: if logado() && (resource.data.dono == request.auth.uid
        || (meuEmail() == email && conviteServe(resource.data)));
      allow create: if logado() && request.resource.data.dono == request.auth.uid && email == email.lower();
      allow update: if logado() && resource.data.dono == request.auth.uid
        && request.resource.data.dono == request.auth.uid;
      allow delete: if logado() && (resource.data.dono == request.auth.uid || meuEmail() == email);
    }

    // Códigos de indicação: quem está criando a conta (ainda sem login) só
    // confere o código que digitou; listar e cadastrar, só o administrador.
    match /indicacoes/{codigo} {
      allow get: if true;
      allow list, write: if admin();
    }
    match /admins/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      // O criador se registra ao entrar, só com o e-mail dele já confirmado.
      allow create: if logado() && request.auth.uid == uid
          && request.auth.token.email == 'eitogestaorural@gmail.com'
          && request.auth.token.email_verified == true;
    }
    // Adesões por código: o administrador conta os perfis com cada indicação.
    match /usuarios/{u} {
      allow read: if admin();
    }

    // ---------- Parte da empresa (vinda do BovinoTech) ----------
    // admin() = quem está em admins/{uid} (o mesmo dos códigos de indicação).
    // Cadastro de quem usa o app. O cliente só cria a própria conta em teste
    // e só atualiza o resumo do acesso; plano, teste e suspensão são do criador.
    match /contas/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin() || membro(uid));
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'ativa'
        && request.resource.data.plano == 'Teste'
        && request.resource.data.teste_ate is timestamp
        && request.resource.data.teste_ate < request.time + duration.value(32, 'd');
      allow update: if admin() || (logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'nome', 'papel', 'dono', 'ultimo_acesso', 'animais', 'propriedades', 'telefone', 'uf', 'uso', 'aparelhos']));
      allow delete: if admin();
    }

    match /contas_notas/{uid} {
      allow read, write: if admin();
    }
    // Pagamentos, histórico das mudanças e respostas prontas: só o criador.
    match /pagamentos/{id} {
      allow read, write: if admin();
    }
    match /contas_historico/{id} {
      allow read, write: if admin();
    }
    match /respostas_prontas/{id} {
      allow read, write: if admin();
    }
    // Nota que o cliente dá ao app (NPS): cada um grava a sua; o criador lê todas.
    match /nps/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 0 && request.resource.data.nota <= 10;
    }

    // Chamados de suporte: o cliente vê e conversa nos dele.
    match /chamados/{id} {
      allow read: if logado() && (resource.data.uid == request.auth.uid || admin());
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'aberto';
      allow update: if admin() || (logado() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mensagens', 'atualizado_em', 'status', 'lido_cliente', 'lido_equipe'])
        && (request.resource.data.status == resource.data.status
          || request.resource.data.status in ['aberto', 'fechado']));
      allow delete: if admin();
    }

    // Comunicados (faixa no topo do app): todos leem, só o criador escreve.
    match /comunicados/{id} {
      allow read: if logado();
      allow write: if admin();
    }

    // Cotação de medicamentos e insumos: um documento por fornecedor, com um
    // código sorteado no nome (vai no link do WhatsApp). O fornecedor abre o
    // link sem login, lê só aquele documento e grava uma vez os preços.
    function donoDaCotacao(d) {
      return logado() && (d.dono == request.auth.uid || membro(d.dono));
    }
    match /pedidos_cotacao/{codigo} {
      allow get: if true;
      allow list: if donoDaCotacao(resource.data);
      allow create: if donoDaCotacao(request.resource.data)
        && request.resource.data.status == 'aberta' && codigo.size() >= 20;
      allow update: if (donoDaCotacao(resource.data) && request.resource.data.dono == resource.data.dono)
        || (resource.data.status == 'aberta' && request.resource.data.status == 'respondida'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'precos', 'precos_30_60_90', 'precos_90_direto', 'frete', 'prazo', 'pagamento', 'obs', 'respondido_por', 'respondido_em'])
          && request.resource.data.precos is list
          && request.resource.data.precos.size() == resource.data.itens.size()
          && request.resource.data.get('precos_30_60_90', []).size() <= resource.data.itens.size()
          && request.resource.data.get('precos_90_direto', []).size() <= resource.data.itens.size()
          && request.resource.data.respondido_em == request.time);
      allow delete: if donoDaCotacao(resource.data);
    }

    // E-mail de boas-vindas (extensão "Trigger Email" do Firebase lê esta
    // coleção e envia). A pessoa só cria o da própria conta, uma vez.
    match /mail/{uid} {
      // Só o destinatário e a mensagem: sem cc, bcc, from ou replyTo (evita spam pelo remetente do app).
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html']);
      allow read, update, delete: if admin();
    }

    // Cotação do boi gordo na B3 (o GitHub Actions grava todo dia).
    match /mercado/{doc} {
      allow read: if logado();
      allow write: if admin();
    }

    // Todo o resto fica bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
